rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Used by AuthContext + trophyUpdates for login/profile/stats
    match /players/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Used by EconomyContext for coins/missions/shop state
    match /playerEconomy/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
