rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Used by AuthContext + trophyUpdates for login/profile/stats.
    // Read is open to any signed-in user so the leaderboard can query
    // across all players' trophy counts; writes stay owner-only.
    match /players/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // Used by EconomyContext for coins/missions/shop state
    match /playerEconomy/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Real-player matchmaking (lib/matchmaking.ts).
    // Read is open to any signed-in user so a client can see who else is
    // waiting for the same game; each player may only create/delete their
    // OWN queue entry (no one can remove or edit someone else's).
    match /matchmakingQueue/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // A live match. Read is open to any signed-in user so Spectator Mode
    // can watch a friend's match (components/game/SpectateClient.tsx) -
    // this is the same accepted trade-off already documented in
    // lib/matchmaking.ts (a technically savvy user could always inspect
    // raw match data, hands included, via devtools; the UI itself just
    // never renders a spectator's or opponent's hand). Only a match's own
    // players may create or update it - a spectator can look but never
    // touch the game state.
    match /matches/{matchId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.players;
      allow update: if request.auth != null && request.auth.uid in resource.data.players;
      allow delete: if false;
    }

    // Private rooms (lib/rooms.ts). The room CODE (the document id) is the
    // real access control - like a shared invite link - so read is open to
    // any signed-in user who already knows the code. Only the owner may
    // create a room in their own name, and either the owner (managing the
    // room) or someone becoming a listed player (joining) may update it.
    match /rooms/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerUid;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.ownerUid || request.auth.uid in request.resource.data.players);
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }

    // Friends (lib/friends.ts). A request document belongs to neither side
    // exclusively - either the sender or recipient may read, update
    // (accept/decline), or delete (cancel/unfriend) it, which avoids ever
    // needing to write into someone else's personal document.
    match /friendRequests/{requestId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.from;
      allow update, delete: if request.auth != null &&
        (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
    }

    // Room invites (lib/friends.ts) - a lightweight notification, not an
    // access grant (the room's own rules and code/password still apply).
    match /roomInvites/{inviteId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.from;
      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
    }

    // Direct messages (lib/messages.ts). The conversation doc's id is
    // deterministic (sorted uids joined), and only its two participants may
    // ever read or write it or its messages subcollection. Messages are
    // never edited or deleted once sent (no update/delete allow rule).
    match /dmConversations/{conversationId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/dmConversations/$(conversationId)).data.participants;
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/dmConversations/$(conversationId)).data.participants &&
          request.auth.uid == request.resource.data.senderUid;
        allow update, delete: if false;
      }
    }

    // Clubs (lib/clubs.ts). Browsable by any signed-in user (same as
    // players/leaderboard) so people can find and join one; only the owner
    // or someone becoming a listed member may update the roster, and only
    // the owner may create a club in their own name.
    match /clubs/{clubId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerUid &&
        request.auth.uid in request.resource.data.members;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.ownerUid || request.auth.uid in request.resource.data.members);
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;

      // Club chat - only current members may read or post.
      match /messages/{messageId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.members;
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.members &&
          request.auth.uid == request.resource.data.senderUid;
        allow update, delete: if false;
      }
    }
  }
}
