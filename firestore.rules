rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Used by AuthContext + trophyUpdates for login/profile/stats.
    // Read is open to any signed-in user so the leaderboard can query
    // across all players' trophy counts; writes stay owner-only.
    match /players/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // Used by EconomyContext for coins/missions/shop state
    match /playerEconomy/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Real-player matchmaking (lib/matchmaking.ts).
    // Read is open to any signed-in user so a client can see who else is
    // waiting for the same game; each player may only create/delete their
    // OWN queue entry (no one can remove or edit someone else's).
    match /matchmakingQueue/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // A live match. Only its participants may read or write it; a match may
    // only be created by one of the players listed in it. Match state is
    // otherwise trusted client-side (no server authority) - see the
    // limitations noted at the top of lib/matchmaking.ts.
    match /matches/{matchId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.players;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.players;
      allow update: if request.auth != null && request.auth.uid in resource.data.players;
      allow delete: if false;
    }
  }
}
